# Site URL (server-only — for SEO/metadata)
# Vercel production (custom domain live):
# SITE_URL=https://silentcpo.me
# Local dev:
SITE_URL=http://localhost:3000

# Admin access (generate a long random string)
ADMIN_SECRET=your-secure-admin-secret-here

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database — Neon Postgres via Vercel Storage integration
# After connecting Neon in Vercel: run `vercel env pull .env.local`
DATABASE_URL="postgresql://..."
DATABASE_URL_UNPOOLED="postgresql://..."

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# MailerSend (https://app.mailersend.com — contact form notifications)
MAILERSEND_API_KEY=mlsn.xxx
MAILERSEND_FROM_EMAIL=hello@silentcpo.me
MAILERSEND_FROM_NAME=SilentCPO
# Optional — defaults to hello@silentcpo.me
CONTACT_NOTIFY_EMAIL=hello@silentcpo.me
