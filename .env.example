# =============================================================================
# SilentCPO — Environment variables cheat sheet
# =============================================================================
# In Vercel you will see MANY vars. Most are auto-injected — you only need to
# set the ones in section 1 below. See README for full Vercel setup notes.
# =============================================================================

# --- 1. YOU SET THESE (required for production) -----------------------------

# Admin dashboard login (/admin)
ADMIN_SECRET=your-secure-admin-secret-here

# MailerSend — contact form emails to you
MAILERSEND_API_KEY=mlsn.xxx
MAILERSEND_FROM_EMAIL=hello@silentcpo.me
MAILERSEND_FROM_NAME=SilentCPO
CONTACT_NOTIFY_EMAIL=hello@silentcpo.me

# Cloudflare Turnstile — bot protection on contact form
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# --- 2. YOU SET THESE (optional but recommended) ----------------------------

# Site URL for SEO/metadata (once silentcpo.me DNS is live)
SITE_URL=https://silentcpo.me

# Stripe — admin payment links & invoices (skip until you need billing)
STRIPE_SECRET_KEY=sk_test_...

# --- 3. AUTO-SET BY NEON (via Vercel Storage — do NOT edit) -----------------
# Prisma uses DATABASE_URL + DATABASE_URL_UNPOOLED only.
# Neon may also add POSTGRES_*, PGHOST, PGUSER, etc. — safe to ignore.

DATABASE_URL=postgresql://...          # pooled — app runtime (auto-set by Neon)
DATABASE_URL_UNPOOLED=postgresql://... # direct — prisma migrations (auto-set by Neon)
# If UNPOOLED is missing, build falls back to DATABASE_URL or POSTGRES_URL_NON_POOLING

# --- 4. AUTO-SET BY VERCEL (do NOT edit) ------------------------------------
# VERCEL, VERCEL_ENV, VERCEL_URL, VERCEL_PROJECT_PRODUCTION_URL, etc.
# Used internally for deploys and as SITE_URL fallback.

# --- 5. NOT USED BY THIS PROJECT (safe to delete from Vercel if present) ----
# STRIPE_WEBHOOK_SECRET  — no webhook route yet
# RESEND_API_KEY         — replaced by MailerSend

# --- Local dev only ---------------------------------------------------------
# After Neon is connected:  vercel env pull .env.local
# SITE_URL=http://localhost:3000
