# Site (must include https:// — on Vercel, VERCEL_URL is used if this is unset)
NEXT_PUBLIC_SITE_URL=https://silentcpo.me

# Admin access (generate a long random string)
ADMIN_SECRET=your-secure-admin-secret-here

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Database (SQLite for local, swap for Postgres in production)
DATABASE_URL="file:./dev.db"

# Cloudflare Turnstile (https://dash.cloudflare.com → Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...
TURNSTILE_SECRET_KEY=0x...

# Optional: email notifications via Resend
# RESEND_API_KEY=re_...
# CONTACT_EMAIL=hello@silentcpo.me
