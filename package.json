{
  "name": "silentcpo-site",
  "version": "0.1.0",
  "private": true,
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true,
    "unrs-resolver@1.12.2": true
  },
  "scripts": {
    "postinstall": "node scripts/ensure-db-env.mjs prisma generate",
    "dev": "next dev",
    "build": "node scripts/ensure-db-env.mjs prisma generate && node scripts/migrate-if-configured.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:push": "node scripts/ensure-db-env.mjs prisma db push",
    "db:deploy": "node scripts/migrate-if-configured.mjs",
    "db:studio": "node scripts/ensure-db-env.mjs prisma studio"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@prisma/client": "^6.19.0",
    "framer-motion": "^12.23.24",
    "lucide-react": "^0.544.0",
    "mailersend": "^2.8.0",
    "next": "^16.3.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^19.1.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.888.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "postcss": "^8.5.6",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2"
  }
}
