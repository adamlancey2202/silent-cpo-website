    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "has-topics",
              "leftValue": "={{ $json.topics.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-topics",
      "name": "Any ready topics?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1000, 120]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst siteBaseUrl = $('Set site base URL').first().json.siteBaseUrl;\nconst topics = [...(ctx.topics || [])].sort((a, b) => {\n  const pa = a.data?.priority ?? 99;\n  const pb = b.data?.priority ?? 99;\n  return pa - pb;\n});\nconst topic = topics[0];\nif (!topic) {\n  return [{ json: { skipped: true, reason: 'no ready topics' } }];\n}\nreturn [{\n  json: {\n    siteBaseUrl,\n    topicId: topic.id,\n    topicTitle: topic.title,\n    profile: ctx.profile,\n    sources: ctx.sources,\n    existingArticles: ctx.existingArticles,\n    requestKey: `topic-${topic.id}-draft-v1`,\n    placeholderTitle: `Draft for ${topic.title}`,\n    placeholderSlug: topic.title.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 80)\n  }\n}];"
      },
      "id": "pick-topic",
      "name": "Pick highest-priority topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1240, 40]
    },
    {
      "parameters": {
        "content": "## Replace this branch with OpenAI\n\nUse profile voice, exclusions, and approved source `.data.text` only.\n\nThen POST the real title, slug, and body.\n\nThe node below sends a **placeholder** draft so you can test connectivity — delete or disable it before production.",
        "height": 220,
        "width": 420
      },
      "id": "note-openai",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [1180, -200]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.siteBaseUrl }}/api/automation/content",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"requestKey\": \"{{ $json.requestKey }}\",\n  \"topicId\": \"{{ $json.topicId }}\",\n  \"title\": \"{{ $json.placeholderTitle }}\",\n  \"slug\": \"{{ $json.placeholderSlug }}\",\n  \"data\": {\n    \"excerpt\": \"Placeholder from n8n connectivity test — replace with model output.\",\n    \"body\": \"## Replace me\\n\\nThis draft was created by the stub workflow.\",\n    \"metaTitle\": \"{{ $json.placeholderTitle }}\",\n    \"metaDescription\": \"Connectivity test.\",\n    \"keyword\": \"\",\n    \"sources\": \"Stub workflow — no model run.\",\n    \"sourceIds\": []\n  }\n}",
        "options": {}
      },
      "id": "post-placeholder",
      "name": "POST placeholder draft (test only)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1480, 40],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_AFTER_IMPORT",
          "name": "SilentCPO Content API"
        }
      }
    },
    {
