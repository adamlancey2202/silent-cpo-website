generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  project   String
  budget    String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentLink {
  id            String   @id @default(cuid())
  stripeId      String   @unique
  url           String
  customerName  String
  customerEmail String
  amount        Int
  currency      String   @default("gbp")
  description   String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  stripeId      String   @unique
  customerName  String
  customerEmail String
  amount        Int
  currency      String   @default("gbp")
  description   String?
  status        String   @default("draft")
  hostedUrl     String?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Validated by src/lib/content/schema.ts. Public queries only read published articles.
model ContentEntry {
  id          String   @id @default(cuid())
  kind        String
  title       String
  status      String
  data        Json
  slug        String?  @unique
  publishedAt DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, status, updatedAt])
}

model ContentRun {
  id          String   @id @default(cuid())
  requestKey  String   @unique
  requestHash String
  articleId   String
  topicId     String?
  message     String
  createdAt   DateTime @default(now())
}

model ContentTopicPlanRun {
  id          String   @id @default(cuid())
  requestKey  String   @unique
  requestHash String
  topicIds    Json
  message     String
  createdAt   DateTime @default(now())
}
