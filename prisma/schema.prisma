generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_PRISMA_URL")
}

model Contact {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  project   String
  budget    String?
  message   String
  status    String   @default("new")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentLink {
  id            String   @id @default(cuid())
  stripeId      String   @unique
  url           String
  customerName  String
  customerEmail String
  amount        Int
  currency      String   @default("gbp")
  description   String?
  status        String   @default("active")
  createdAt     DateTime @default(now())
}

model Invoice {
  id            String   @id @default(cuid())
  stripeId      String   @unique
  customerName  String
  customerEmail String
  amount        Int
  currency      String   @default("gbp")
  description   String?
  status        String   @default("draft")
  hostedUrl     String?
  pdfUrl        String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Validated by src/lib/content/schema.ts. Public queries only read published articles.
model ContentEntry {
  id          String   @id @default(cuid())
  kind        String
  title       String
  status      String
  data        Json
  slug        String?  @unique
  publishedAt DateTime?
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([kind, status, updatedAt])
}

model ContentRun {
  id          String   @id @default(cuid())
  requestKey  String   @unique
  requestHash String
  articleId   String
  topicId     String?
  message     String
  createdAt   DateTime @default(now())
}

model ContentTopicPlanRun {
  id          String   @id @default(cuid())
  requestKey  String   @unique
  requestHash String
  topicIds    Json
  message     String
  createdAt   DateTime @default(now())
}

// Delivery tracker (admin project tool). Money fields stay text so vouchers
// and partial payments can be written the way they were agreed.
model StudioClient {
  id        String          @id @default(cuid())
  name      String
  email     String          @default("")
  phone     String          @default("")
  whatsapp  String          @default("")
  notes     String          @default("")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  projects  StudioProject[]
}

model StudioProject {
  id                String       @id @default(cuid())
  clientId          String?
  client            StudioClient? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  title             String
  description       String       @default("")
  projectType       String       @default("website")
  status            String       @default("enquiry")
  budget            String       @default("")
  agreedCost        String       @default("")
  amountPaid        String       @default("")
  paymentType       String       @default("money")
  paymentNotes      String       @default("")
  deadline          String       @default("")
  notes             String       @default("")
  whatDoing         String       @default("")
  discoveryFeedback String       @default("") @db.Text
  quoteText         String       @default("") @db.Text
  quoteFilename     String       @default("")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  tasks             StudioTask[]

  @@index([status, updatedAt])
  @@index([clientId])
}

model StudioTask {
  id          String         @id @default(cuid())
  projectId   String?
  project     StudioProject? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String         @default("")
  status      String         @default("todo")
  priority    String         @default("medium")
  dueDate     String         @default("")
  phase       String         @default("")
  sortOrder   Int            @default(0)
  onTaskList  Boolean        @default(false)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([projectId, status, sortOrder])
}

// Scored freelance listings from the project finder. Email is sent only from admin.
model ProjectLead {
  id           String    @id @default(cuid())
  url          String    @unique
  source       String
  title        String
  excerpt      String    @default("") @db.Text
  score        Int
  budget       String    @default("")
  why          String    @default("") @db.Text
  reply        String    @default("") @db.Text
  contactEmail String    @default("")
  status       String    @default("new")
  sentAt       DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status, createdAt])
}

model NewsletterSubscriber {
  id               String   @id @default(cuid())
  email            String   @unique
  name             String?
  source           String?
  status           String   @default("subscribed")
  unsubscribeToken String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Public marketing settings (measurement IDs are not secrets; editable in admin).
model SiteSettings {
  id               String   @id @default("default")
  ga4MeasurementId String   @default("")
  ga4PropertyId    String   @default("")
  gscSiteUrl       String   @default("")
  version          Int      @default(1)
  updatedAt        DateTime @updatedAt
}
